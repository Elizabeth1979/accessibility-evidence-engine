---
config:
  theme: base
  flowchart:
    curve: basis
    nodeSpacing: 34
    rankSpacing: 58
  themeVariables:
    background: "#050b09"
    primaryColor: "#0d1c19"
    primaryTextColor: "#f1f8f5"
    primaryBorderColor: "#70f0b4"
    lineColor: "#70f0b4"
    secondaryColor: "#142824"
    tertiaryColor: "#342b10"
---
flowchart TB
  define(["1 · Define journey<br/>actions · policy · versions"])
  fork{"2 · Isolate<br/>input lanes"}

  subgraph drivers["ACTIVE DRIVERS · separate browser contexts"]
    direction LR
    pointer["Pointer + hover"]
    keyboard["Keyboard"]
    virtual["Virtual screen reader"]
    at["VoiceOver / NVDA<br/>optional fidelity"]
  end

  subgraph loop["3 · FOR EACH MEANINGFUL ACTION"]
    direction LR
    before["Capture<br/>before"] --> action["Perform one<br/>role-aware action"] --> after["Capture<br/>after"]
  end

  observers["PASSIVE OBSERVERS<br/>viewport + full page · DOM · AOM<br/>focus · axe · transcript · video"]
  correlate["4 · Correlate<br/>immutable evidence graph"]

  subgraph analysis["5 · ANALYZE AND VERIFY"]
    direction LR
    deterministic["5a · Deterministic<br/>rules + ACT-style outcomes"]
    route{"Contextual<br/>judgment allowed?"}
    ai["5b · AI specialist<br/>labeled + evidence-citing"]
    verify["5c · Cross-evidence<br/>verification + policy"]
  end
  report(["6 · Integrated report<br/>HTML · JSON · Markdown"])
  rerun["Optional isolated fix<br/>+ verified rerun"]

  define --> fork
  fork --> pointer
  pointer ~~~ keyboard ~~~ virtual ~~~ at
  pointer & keyboard & virtual & at --> before
  after -.->|next action| before
  before & after -.->|same checkpoint| observers
  after --> correlate
  observers --> correlate
  correlate --> deterministic --> route
  route -->|No| verify
  route -->|Yes| ai --> verify
  verify --> report
  report -.-> rerun

  classDef available fill:#0b2b21,stroke:#70f0b4,color:#f1f8f5,stroke-width:2px
  classDef planned fill:#342b10,stroke:#ffd86b,color:#f1f8f5,stroke-width:2px
  classDef decision fill:#142824,stroke:#70f0b4,color:#f1f8f5,stroke-width:2px
  classDef output fill:#123d2f,stroke:#70f0b4,color:#f1f8f5,stroke-width:3px

  class define,pointer,keyboard,before,action,after,observers,correlate,deterministic available
  class virtual,at,ai,verify,rerun planned
  class fork,route decision
  class report output
