---
config:
  theme: base
  themeVariables:
    primaryColor: "#0d1c19"
    primaryTextColor: "#f1f8f5"
    primaryBorderColor: "#70f0b4"
    lineColor: "#70f0b4"
    secondaryColor: "#142824"
    tertiaryColor: "#342b10"
---
flowchart TD
  define["1. Define journey, profile, and evidence policy"] --> fork{"2. Fork isolated active lanes"}

  subgraph lanes["Active input drivers - never share a page"]
    direction LR
    pointer["Pointer and hover"]
    keyboard["Keyboard"]
    virtual["Virtual screen reader"]
    at["VoiceOver or NVDA - optional AT fidelity"]
  end

  fork --> pointer
  fork --> keyboard
  fork --> virtual
  fork -. optional .-> at

  pointer & keyboard & virtual & at --> before["3a. Synchronized before checkpoint"]
  before --> action["3b. One meaningful, role-aware action"]
  action --> after["3c. Synchronized after checkpoint"]

  subgraph observers["Passive observers at every checkpoint"]
    direction LR
    visual["Viewport and full-page images"]
    dom["Full DOM and computed state"]
    aom["Full accessibility tree"]
    focus["Deep focus state"]
    axe["Pinned axe rules"]
    trace["Action, transcript, video, network"]
  end

  before -. capture same state .-> visual & dom & aom & focus & axe & trace
  after -. capture same state .-> visual & dom & aom & focus & axe & trace
  after --> more{"More meaningful actions?"}
  more -->|Yes| before
  more -->|No| correlate["4. Correlate immutable evidence graph"]

  correlate --> deterministic["5a. Deterministic judges and ACT-style outcomes"]
  deterministic --> route{"Registry allows contextual AI?"}
  route -->|No| verify["5c. Cross-evidence verification and policy"]
  route -->|Yes| ai["5b. Labeled specialist AI output with evidence citations"]
  ai --> verify
  verify --> report["6. One HTML, JSON, and Markdown report"]
  report -. optional isolated fix .-> rerun["Verified rerun with lineage"]
  rerun --> define

  classDef available fill:#06291d,stroke:#70f0b4,color:#f1f8f5,stroke-width:2px
  classDef planned fill:#342b10,stroke:#ffd86b,color:#f1f8f5,stroke-width:2px
  classDef decision fill:#142824,stroke:#70f0b4,color:#f1f8f5,stroke-width:2px

  class pointer,keyboard,visual,dom,aom,focus available
  class virtual,at,axe,trace,ai,verify,rerun planned
  class fork,more,route decision
