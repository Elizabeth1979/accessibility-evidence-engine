{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aee.dev/schemas/remediation-registry.schema.json",
  "title": "AEE detection, analysis, and remediation registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "registryVersion", "title", "principles", "entries"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "registryVersion": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "principles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "implementationStatus",
        "ruleKind",
        "requirements",
        "patterns",
        "applicability",
        "requiredEvidence",
        "deterministicDetection",
        "ai",
        "verification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "implementationStatus": {
          "enum": ["available", "partial", "planned"]
        },
        "ruleKind": {
          "enum": ["aee-act-compatible", "act-rule"]
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "patterns": {
          "description": "a11y-skills pattern files that explain this concept, by name without the .instructions.md suffix.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "applicability": {
          "type": "string",
          "minLength": 1
        },
        "requiredEvidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "deterministicDetection": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ai": {
          "$ref": "#/$defs/aiPolicy"
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard", "version", "requirementId", "title", "relationship", "url"],
      "properties": {
        "standard": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "requirementId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "enum": ["A", "AA", "AAA"]
        },
        "relationship": {
          "enum": ["primary", "secondary", "detection"]
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "aiPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "required", "purpose", "outputs"],
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        },
        "specialistId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "outputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "allowed": {
                "const": true
              }
            },
            "required": ["allowed"]
          },
          "then": {
            "required": ["specialistId"]
          }
        },
        {
          "if": {
            "properties": {
              "required": {
                "const": true
              }
            },
            "required": ["required"]
          },
          "then": {
            "properties": {
              "allowed": {
                "const": true
              }
            }
          }
        }
      ]
    }
  }
}
