{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Elizabeth1979/accessibility-evidence-engine/main/packages/schemas/json/test-presses.schema.json",
  "title": "AEE Test Presses",
  "description": "The controls a Playwright test pressed, and each press whose result a screen reader user does not hear, with the page as it was just after.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "laneId", "pressesRead", "presses"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "laneId": { "$ref": "./common.schema.json#/$defs/uid" },
    "pressesRead": { "type": "integer", "minimum": 1 },
    "presses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "pageUrl", "findings"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "pageUrl": { "type": "string", "minLength": 1 },
          "screenshot": { "type": "string", "pattern": "^press-[0-9]+\\.png$" },
          "findings": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "./keyboard-pointer-sweep-lane.schema.json#/$defs/finding" }
          }
        }
      }
    }
  }
}
