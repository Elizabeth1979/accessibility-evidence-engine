{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Elizabeth1979/accessibility-evidence-engine/main/packages/schemas/json/judgment.schema.json",
  "title": "AEE Judgment",
  "type": "object",
  "required": ["id", "judgeId", "scope", "verdict", "summary", "evidenceRecordIds"],
  "properties": {
    "id": {
      "$ref": "./common.schema.json#/$defs/uid"
    },
    "judgeId": {
      "type": "string"
    },
    "judgeVersion": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "enum": ["run", "checkpoint", "interaction", "component"]
    },
    "verdict": {
      "$ref": "./common.schema.json#/$defs/verdict"
    },
    "summary": {
      "type": "string"
    },
    "severity": {
      "$ref": "./common.schema.json#/$defs/severity"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidenceRecordIds": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/uid"
      }
    },
    "artifactIds": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/uid"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "./finding.schema.json"
      }
    },
    "rationale": {
      "type": "string"
    },
    "suggestedFix": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
