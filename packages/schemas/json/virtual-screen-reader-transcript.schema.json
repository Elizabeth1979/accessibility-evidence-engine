{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Elizabeth1979/accessibility-evidence-engine/main/packages/schemas/json/virtual-screen-reader-transcript.schema.json",
  "title": "AEE Portable Virtual Screen Reader Transcript",
  "type": "object",
  "required": [
    "schemaVersion",
    "engine",
    "engineVersion",
    "speechEngine",
    "mode",
    "fidelity",
    "physicalAssistiveTechnology",
    "pageUrl",
    "generatedAt",
    "entries"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "engine": { "const": "aee-portable-virtual-screen-reader" },
    "engineVersion": { "const": "0.2.0" },
    "speechEngine": { "type": "string", "minLength": 1 },
    "mode": { "const": "guide" },
    "fidelity": { "const": "semantic-simulation" },
    "physicalAssistiveTechnology": { "const": false },
    "pageUrl": { "type": "string", "format": "uri" },
    "generatedAt": { "$ref": "./common.schema.json#/$defs/isoTimestamp" },
    "currentItem": { "$ref": "#/$defs/item" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    },
    "liveRegionAnnouncements": {
      "type": "array",
      "items": { "$ref": "./common.schema.json#/$defs/liveRegionAnnouncement" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["key", "nodePath", "tagName", "role", "states"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "nodePath": { "type": "string", "minLength": 1 },
        "tagName": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "value": { "type": ["string", "number"] },
        "text": { "type": "string", "minLength": 1 },
        "level": { "type": "integer", "minimum": 1 },
        "states": { "type": "array", "items": { "type": "string" } },
        "properties": {
          "description": "Every state and property the browser's accessibility tree gives the element, as Chrome DevTools Protocol AXProperty objects.",
          "type": "array",
          "items": { "$ref": "#/$defs/accessibilityProperty" }
        },
        "backendDOMNodeId": {
          "description": "The DOM node the reader is on, as the browser session numbers it; joins the item to the accessibility tree captured in the same session.",
          "type": "integer"
        },
        "frameId": {
          "description": "The frame whose document holds the node; with backendDOMNodeId it names the node across every frame, since node ids repeat in frames rendered in other processes.",
          "type": "string",
          "minLength": 1
        },
        "visualBounds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      },
      "additionalProperties": false
    },
    "accessibilityProperty": {
      "type": "object",
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "minLength": 1 },
            "value": true,
            "relatedNodes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["backendDOMNodeId"],
                "properties": {
                  "backendDOMNodeId": { "type": "integer" },
                  "idref": { "type": "string" },
                  "text": { "type": "string" }
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": ["sequence", "timestamp", "command", "announcement", "focusMoved"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "timestamp": { "$ref": "./common.schema.json#/$defs/isoTimestamp" },
        "command": {
          "enum": [
            "start",
            "next-item",
            "previous-item",
            "next-heading",
            "previous-heading",
            "next-landmark",
            "next-control",
            "read-current"
          ]
        },
        "announcement": { "type": "string" },
        "item": { "$ref": "#/$defs/item" },
        "domFocusBefore": { "type": "string" },
        "domFocusAfter": { "type": "string" },
        "focusMoved": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
