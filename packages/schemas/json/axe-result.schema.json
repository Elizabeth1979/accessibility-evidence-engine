{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Elizabeth1979/accessibility-evidence-engine/main/packages/schemas/json/axe-result.schema.json",
  "title": "AEE axe result",
  "description": "An axe-core 4.14 result as AEE writes it at a checkpoint (axe-before.json, axe-after.json): axe's own result, with what AEE adds to it. It checks the axe fields AEE reads, with axe's own types and optionality (axe-core's axe.d.ts), and AEE's additions in full; axe's other fields are kept as axe wrote them and not checked here.",
  "type": "object",
  "required": ["violations", "incomplete", "passes", "inapplicable"],
  "properties": {
    "violations": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
    "incomplete": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
    "passes": {
      "description": "Rules that passed; AEE reads how many there are.",
      "type": "array"
    },
    "inapplicable": {
      "description": "Rules that applied to nothing on the page; AEE reads how many there are.",
      "type": "array"
    },
    "framesNotChecked": {
      "description": "Added by AEE: frames left out of the analysis, such as one whose page is outside the allowed origins. Absent when every frame was checked.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/frameNotChecked" }
    }
  },
  "$defs": {
    "rule": {
      "description": "One rule's result (axe's Result).",
      "type": "object",
      "required": ["id", "help", "description", "helpUrl", "tags", "nodes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "impact": {
          "description": "Optional in axe: it gives none for a rule with no impact of its own.",
          "$ref": "#/$defs/impact"
        },
        "help": { "type": "string" },
        "description": { "type": "string" },
        "helpUrl": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } }
      }
    },
    "node": {
      "description": "One element a rule found (axe's NodeResult).",
      "type": "object",
      "required": ["html", "target", "any"],
      "properties": {
        "html": { "type": "string" },
        "target": { "$ref": "#/$defs/target" },
        "any": { "type": "array", "items": { "$ref": "#/$defs/check" } },
        "failureSummary": {
          "description": "Optional in axe: it writes one for a node that failed or that it could not decide.",
          "type": "string"
        },
        "aeeTarget": {
          "description": "Added by AEE to a violation's node it found on the page: where the element sits on the full-page screenshot.",
          "$ref": "./common.schema.json#/$defs/targetBox"
        },
        "aeeContext": {
          "description": "Added by AEE to a violation's node an AI specialist may be asked about: the page around the element.",
          "$ref": "#/$defs/elementContext"
        },
        "aeeContrast": {
          "description": "Added by AEE to a color-contrast node axe could not decide: its measurement of the pixels behind the text.",
          "$ref": "#/$defs/contrastMeasurement"
        }
      }
    },
    "impact": { "enum": ["minor", "moderate", "serious", "critical", null] },
    "target": {
      "description": "axe's path to the element (UnlabelledFrameSelector): one entry per document, outermost first; an entry that is a list steps into shadow roots.",
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          { "type": "string" },
          { "type": "array", "minItems": 2, "items": { "type": "string" } }
        ]
      }
    },
    "check": {
      "description": "One check axe ran on the node (axe's CheckResult). Its data is the check's own; AEE reads the color-contrast check's.",
      "type": "object",
      "required": ["id", "message", "data"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "data": { "description": "Whatever the check recorded; null when it recorded nothing." }
      },
      "if": { "properties": { "id": { "const": "color-contrast" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/colorContrastData" } } }
    },
    "colorContrastData": {
      "description": "What axe's color-contrast check records. Each field is absent when axe could not tell, such as a background color behind an image.",
      "type": ["object", "null"],
      "properties": {
        "fgColor": { "type": "string" },
        "bgColor": { "type": "string" },
        "contrastRatio": { "type": ["number", "null"] },
        "expectedContrastRatio": { "type": "string", "pattern": "^[0-9.]+:1$" },
        "fontSize": { "type": "string" },
        "fontWeight": { "type": "string" },
        "messageKey": {
          "description": "Why axe could not decide, such as bgGradient; null or absent when it measured the text.",
          "type": ["string", "null"]
        }
      }
    },
    "elementContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tagName", "role", "name", "ignoredReasons", "text", "iconOnly", "iconHints"],
      "properties": {
        "tagName": { "type": "string", "minLength": 1 },
        "role": { "type": "string" },
        "name": { "type": "string" },
        "ignoredReasons": { "type": "array", "items": { "type": "string" } },
        "text": { "type": "string" },
        "iconOnly": { "type": "boolean" },
        "iconHints": { "type": "array", "items": { "type": "string" } },
        "nearbyHeading": { "type": "string" },
        "nearbyText": { "type": "string" },
        "destination": { "type": "string" },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["soleContentOfLinkOrButton"],
          "properties": {
            "source": { "type": "string" },
            "alt": { "type": "string" },
            "title": { "type": "string" },
            "caption": { "type": "string" },
            "linkOrButtonText": { "type": "string" },
            "soleContentOfLinkOrButton": { "type": "boolean" }
          }
        }
      }
    },
    "contrastMeasurement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["verdict", "requiredRatio", "foreground", "lowest", "highest"],
          "properties": {
            "verdict": { "enum": ["pass", "fail", "undecided"] },
            "requiredRatio": { "type": "number", "exclusiveMinimum": 0 },
            "foreground": { "type": "string" },
            "lowest": { "$ref": "#/$defs/contrastExtreme" },
            "highest": { "$ref": "#/$defs/contrastExtreme" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["verdict", "requiredRatio", "reason"],
          "properties": {
            "verdict": { "const": "unmeasured" },
            "requiredRatio": { "type": "number", "exclusiveMinimum": 0 },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "contrastExtreme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ratio", "background"],
      "properties": {
        "ratio": { "type": "number", "minimum": 1 },
        "background": { "type": "string" }
      }
    },
    "frameNotChecked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "reason", "name", "selector"],
      "properties": {
        "url": { "type": "string" },
        "reason": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "selector": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
