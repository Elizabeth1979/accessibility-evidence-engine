{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Elizabeth1979/accessibility-evidence-engine/main/packages/schemas/json/common.schema.json",
  "title": "AEE Common Definitions",
  "$defs": {
    "uid": {
      "type": "string",
      "minLength": 1
    },
    "isoTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "liveRegionAnnouncement": {
      "description": "A live-region update Guidepup's virtual screen reader announced (WAI-ARIA 1.2 aria-live).",
      "type": "object",
      "required": ["sequence", "timestamp", "politeness", "text"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "timestamp": { "$ref": "#/$defs/isoTimestamp" },
        "politeness": { "enum": ["polite", "assertive"] },
        "text": { "type": "string" }
      },
      "additionalProperties": false
    },
    "artifactKind": {
      "type": "string",
      "enum": [
        "screenshot",
        "dom-snapshot",
        "accessibility-tree",
        "element-map",
        "network-log",
        "screen-reader-log",
        "axe-result",
        "trace",
        "video",
        "custom"
      ]
    },
    "artifactRef": {
      "type": "object",
      "required": ["id", "kind", "path"],
      "properties": {
        "id": {
          "$ref": "#/$defs/uid"
        },
        "kind": {
          "$ref": "#/$defs/artifactKind"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "mediaType": {
          "type": "string"
        },
        "contentHash": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "targetDescriptor": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "selector": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "nodePath": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "severity": {
      "type": "string",
      "enum": ["info", "low", "medium", "high", "critical"]
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail", "unknown"]
    },
    "targetBox": {
      "description": "Where an element sits on the full-page screenshot, in CSS pixels, with the page's own size.",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height", "pageWidth", "pageHeight"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 },
        "pageWidth": { "type": "number", "minimum": 0 },
        "pageHeight": { "type": "number", "minimum": 0 }
      }
    }
  }
}
