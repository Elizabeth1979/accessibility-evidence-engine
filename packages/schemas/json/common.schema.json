{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Elizabeth1979/accessibility-evidence-engine/main/packages/schemas/json/common.schema.json",
  "title": "AEE Common Definitions",
  "$defs": {
    "uid": {
      "type": "string",
      "minLength": 1
    },
    "isoTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "digest": {
      "description": "A SHA-256 digest, as AEE fingerprints a scenario and its approved plan.",
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "liveRegionAnnouncement": {
      "description": "A live-region update Guidepup's virtual screen reader announced (WAI-ARIA 1.2 aria-live).",
      "type": "object",
      "required": ["sequence", "timestamp", "politeness", "text"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "timestamp": { "$ref": "#/$defs/isoTimestamp" },
        "politeness": { "enum": ["polite", "assertive"] },
        "text": {
          "description": "What the reader said, without its politeness prefix.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "interactionKind": {
      "description": "What the interaction did: a key, a pointer action, typing, a screen-reader command, or custom.",
      "type": "string",
      "enum": [
        "tab",
        "shift-tab",
        "click",
        "hover",
        "focus",
        "enter",
        "space",
        "escape",
        "arrow-key",
        "type",
        "submit",
        "screen-reader-command",
        "custom"
      ]
    },
    "artifactKind": {
      "type": "string",
      "enum": [
        "screenshot",
        "dom-snapshot",
        "accessibility-tree",
        "element-map",
        "network-log",
        "screen-reader-log",
        "axe-result",
        "trace",
        "video",
        "custom"
      ]
    },
    "artifactRef": {
      "type": "object",
      "required": ["id", "kind", "path"],
      "properties": {
        "id": {
          "$ref": "#/$defs/uid"
        },
        "kind": {
          "$ref": "#/$defs/artifactKind"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "mediaType": {
          "type": "string"
        },
        "contentHash": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "targetDescriptor": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "exact": {
          "type": "boolean",
          "description": "Whether name is the whole accessible name (true, the default) or a part of it, matched without regard to case, as Playwright's getByRole takes it."
        },
        "selector": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "nodePath": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "severity": {
      "type": "string",
      "enum": ["info", "low", "medium", "high", "critical"]
    },
    "runSummary": {
      "description": "How many judgments passed, failed and could not decide.",
      "type": "object",
      "required": ["pass", "fail", "unknown"],
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail", "unknown"]
    },
    "targetBox": {
      "description": "Where an element sits on the full-page screenshot, in CSS pixels, with the page's own size.",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height", "pageWidth", "pageHeight"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 },
        "pageWidth": { "type": "number", "minimum": 0 },
        "pageHeight": { "type": "number", "minimum": 0 }
      }
    },
    "videoEvidence": {
      "description": "The recording of a lane, captioned step by step: the video, its sidecar and its captions.",
      "type": "object",
      "additionalProperties": false,
      "required": ["videoFile", "sidecarFile", "captionsFile"],
      "properties": {
        "videoFile": { "type": "string", "minLength": 1 },
        "sidecarFile": { "type": "string", "minLength": 1 },
        "captionsFile": { "type": "string", "minLength": 1 }
      }
    }
  }
}
