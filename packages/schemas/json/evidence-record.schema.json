{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Elizabeth1979/accessibility-evidence-engine/main/packages/schemas/json/evidence-record.schema.json",
  "title": "AEE Evidence Record",
  "type": "object",
  "required": ["id", "runId", "observerId", "phase", "status", "timestamp"],
  "properties": {
    "id": {
      "$ref": "./common.schema.json#/$defs/uid"
    },
    "runId": {
      "$ref": "./common.schema.json#/$defs/uid"
    },
    "checkpointId": {
      "$ref": "./common.schema.json#/$defs/uid"
    },
    "interactionId": {
      "$ref": "./common.schema.json#/$defs/uid"
    },
    "observerId": {
      "type": "string"
    },
    "observerVersion": {
      "type": "string"
    },
    "phase": {
      "type": "string",
      "enum": ["before", "after", "continuous"]
    },
    "status": {
      "type": "string",
      "enum": ["ok", "unsupported", "no_signal", "observer_error", "timeout"]
    },
    "timestamp": {
      "$ref": "./common.schema.json#/$defs/isoTimestamp"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "summary": {
      "type": "string"
    },
    "beforeStateRef": {
      "$ref": "./common.schema.json#/$defs/artifactRef"
    },
    "afterStateRef": {
      "$ref": "./common.schema.json#/$defs/artifactRef"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/artifactRef"
      }
    },
    "rawRef": {
      "$ref": "./common.schema.json#/$defs/artifactRef"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "summary"],
        "properties": {
          "path": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "before": {},
          "after": {},
          "impact": {
            "type": "string",
            "enum": ["none", "minor", "major", "unknown"]
          }
        },
        "additionalProperties": false
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "meta": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["observerId"],
        "properties": { "observerId": { "const": "accessibility-tree" } }
      },
      "then": {
        "properties": {
          "meta": {
            "type": "object",
            "properties": {
              "accessibilityChanges": { "$ref": "#/$defs/accessibilityChanges" },
              "accessibilityChangesWithoutInput": {
                "description": "What changed in the tree on its own while the page was left untouched before the interaction.",
                "$ref": "#/$defs/accessibilityChanges"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["observerId"],
        "properties": { "observerId": { "const": "virtual-screen-reader" } }
      },
      "then": {
        "properties": {
          "meta": {
            "type": "object",
            "properties": {
              "newLiveRegionAnnouncements": {
                "type": "array",
                "items": { "$ref": "./common.schema.json#/$defs/liveRegionAnnouncement" }
              },
              "liveRegionAnnouncementsWithoutInput": {
                "description": "Live-region updates the reader heard before the interaction, from the page on its own.",
                "type": "array",
                "items": { "$ref": "./common.schema.json#/$defs/liveRegionAnnouncement" }
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "accessibilityNodeRef": {
      "description": "A node of the browser's accessibility tree, as an accessibility-tree record names it.",
      "type": "object",
      "required": ["nodeId", "role"],
      "properties": {
        "nodeId": {
          "description": "The DOM node's backend id, the same in both snapshots for as long as the node lives.",
          "type": "integer"
        },
        "role": { "type": "string" },
        "name": { "type": "string" }
      },
      "additionalProperties": false
    },
    "accessibilityChange": {
      "description": "One change between the accessibility tree before an interaction and after it.",
      "type": "object",
      "required": ["nodeId", "role", "kind"],
      "properties": {
        "nodeId": {
          "description": "The DOM node's backend id, the same in both snapshots for as long as the node lives.",
          "type": "integer"
        },
        "role": { "type": "string" },
        "name": { "type": "string" },
        "kind": {
          "description": "state: a tracked state changed. shown/hidden: the node entered or left the tree. name: its accessible name changed.",
          "enum": ["state", "shown", "hidden", "name"]
        },
        "state": { "enum": ["checked", "expanded", "pressed", "selected", "value"] },
        "before": { "type": ["string", "number", "boolean", "null"] },
        "after": { "type": ["string", "number", "boolean", "null"] },
        "controlledBy": {
          "description": "The nodes whose aria-controls names this node, in either snapshot.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/accessibilityNodeRef"
          }
        }
      },
      "additionalProperties": false
    },
    "accessibilityChanges": {
      "description": "What changed in the browser's accessibility tree between two snapshots: before and after the interaction, or across the untouched watch before it.",
      "type": "object",
      "required": ["changes", "truncated"],
      "properties": {
        "focusedBefore": {
          "description": "The node that had focus before the interaction: what a key press acts on.",
          "$ref": "#/$defs/accessibilityNodeRef"
        },
        "focusedAfter": {
          "description": "The node that has focus after it.",
          "$ref": "#/$defs/accessibilityNodeRef"
        },
        "changes": { "type": "array", "items": { "$ref": "#/$defs/accessibilityChange" } },
        "truncated": {
          "description": "True when more nodes changed than are listed.",
          "type": "boolean"
        },
        "liveRegions": {
          "description": "The live regions that hold a listed change: which region a screen reader would hear from.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/liveRegion"
          }
        }
      },
      "additionalProperties": false
    },
    "liveRegion": {
      "description": "A live region that holds a listed change, as Chrome's accessibility tree reports it.",
      "type": "object",
      "required": ["nodeId", "role", "politeness", "text"],
      "properties": {
        "nodeId": {
          "description": "The DOM node's backend id, the same in both snapshots for as long as the node lives.",
          "type": "integer"
        },
        "role": { "type": "string" },
        "name": { "type": "string" },
        "politeness": { "enum": ["polite", "assertive"] },
        "text": {
          "description": "The region's text in the later snapshot (the earlier one if it left the page), in tree order.",
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
