{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Elizabeth1979/accessibility-evidence-engine/main/packages/schemas/json/evidence-record.schema.json",
  "title": "AEE Evidence Record",
  "type": "object",
  "required": ["id", "runId", "observerId", "phase", "status", "timestamp"],
  "properties": {
    "id": {
      "$ref": "./common.schema.json#/$defs/uid"
    },
    "runId": {
      "$ref": "./common.schema.json#/$defs/uid"
    },
    "checkpointId": {
      "$ref": "./common.schema.json#/$defs/uid"
    },
    "interactionId": {
      "$ref": "./common.schema.json#/$defs/uid"
    },
    "observerId": {
      "type": "string"
    },
    "observerVersion": {
      "type": "string"
    },
    "phase": {
      "type": "string",
      "enum": ["before", "after", "continuous"]
    },
    "status": {
      "type": "string",
      "enum": ["ok", "unsupported", "no_signal", "observer_error", "timeout"]
    },
    "timestamp": {
      "$ref": "./common.schema.json#/$defs/isoTimestamp"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "summary": {
      "type": "string"
    },
    "beforeStateRef": {
      "$ref": "./common.schema.json#/$defs/artifactRef"
    },
    "afterStateRef": {
      "$ref": "./common.schema.json#/$defs/artifactRef"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/artifactRef"
      }
    },
    "rawRef": {
      "$ref": "./common.schema.json#/$defs/artifactRef"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "summary"],
        "properties": {
          "path": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "before": {},
          "after": {},
          "impact": {
            "type": "string",
            "enum": ["none", "minor", "major", "unknown"]
          }
        },
        "additionalProperties": false
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "meta": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
