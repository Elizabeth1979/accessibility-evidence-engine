{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Elizabeth1979/accessibility-evidence-engine/main/packages/schemas/json/cli-config.schema.json",
  "title": "AEE CLI Config",
  "type": "object",
  "required": ["projectRoot", "fixturePath"],
  "properties": {
    "version": {
      "type": "string"
    },
    "projectRoot": {
      "type": "string",
      "minLength": 1
    },
    "outputDir": {
      "type": "string",
      "minLength": 1
    },
    "fixturePath": {
      "type": "string",
      "minLength": 1
    },
    "policy": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "release": {
          "type": "object",
          "properties": {
            "failOnSeverities": {
              "type": "array",
              "items": {
                "$ref": "./common.schema.json#/$defs/severity"
              },
              "uniqueItems": true
            },
            "unknownBehavior": {
              "type": "string",
              "enum": ["ignore", "warn", "fail"]
            },
            "minimumConfidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        "capture": {
          "type": "object",
          "properties": {
            "includeScreenshots": {
              "type": "boolean"
            },
            "includeAccessibilityTree": {
              "type": "boolean"
            },
            "includeDomSnapshot": {
              "type": "boolean"
            },
            "stabilizeAfterInteractionMs": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "observers": {
          "type": "object",
          "properties": {
            "perObserverTimeoutMs": {
              "type": "integer",
              "minimum": 1
            },
            "continueOnObserverError": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "observers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "judges": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checkpointName": {
      "type": "string"
    },
    "interaction": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "tab",
            "shift-tab",
            "click",
            "hover",
            "focus",
            "enter",
            "space",
            "escape",
            "arrow-key",
            "type",
            "submit",
            "custom"
          ]
        },
        "actor": {
          "type": "string",
          "enum": ["test", "engine", "user-script"]
        },
        "target": {
          "$ref": "./common.schema.json#/$defs/targetDescriptor"
        },
        "input": {
          "type": "string"
        },
        "meta": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
