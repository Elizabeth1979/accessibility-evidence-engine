{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Elizabeth1979/accessibility-evidence-engine/main/packages/schemas/json/interaction.schema.json",
  "title": "AEE Interaction",
  "type": "object",
  "required": ["id", "runId", "timestamp", "actor", "kind"],
  "properties": {
    "id": {
      "$ref": "./common.schema.json#/$defs/uid"
    },
    "runId": {
      "$ref": "./common.schema.json#/$defs/uid"
    },
    "checkpointId": {
      "$ref": "./common.schema.json#/$defs/uid"
    },
    "timestamp": {
      "$ref": "./common.schema.json#/$defs/isoTimestamp"
    },
    "actor": {
      "type": "string",
      "enum": ["test", "engine", "user-script"]
    },
    "kind": {
      "type": "string"
    },
    "target": {
      "$ref": "./common.schema.json#/$defs/targetDescriptor"
    },
    "input": {
      "type": "string"
    },
    "meta": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
