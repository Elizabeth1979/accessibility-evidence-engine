{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Elizabeth1979/accessibility-evidence-engine/main/packages/schemas/json/checkpoint.schema.json",
  "title": "AEE Checkpoint",
  "type": "object",
  "required": ["id", "runId", "timestamp", "trigger"],
  "properties": {
    "id": {
      "$ref": "./common.schema.json#/$defs/uid"
    },
    "runId": {
      "$ref": "./common.schema.json#/$defs/uid"
    },
    "name": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "timestamp": {
      "$ref": "./common.schema.json#/$defs/isoTimestamp"
    },
    "trigger": {
      "type": "string",
      "enum": ["initial-load", "post-interaction", "assertion", "manual"]
    },
    "pageSnapshotRef": {
      "$ref": "./common.schema.json#/$defs/artifactRef"
    },
    "artifactIds": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/uid"
      }
    }
  },
  "additionalProperties": false
}
