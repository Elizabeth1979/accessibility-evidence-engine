{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Elizabeth1979/accessibility-evidence-engine/main/packages/schemas/json/scenario-report.schema.json",
  "title": "AEE Integrated Scenario Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "assessmentId",
    "scenarioId",
    "scenarioDigest",
    "planDigest",
    "profile",
    "target",
    "goal",
    "standard",
    "status",
    "verdict",
    "startedAt",
    "finishedAt",
    "completeness",
    "summary",
    "journeys",
    "actions",
    "findings",
    "synthesis",
    "artifacts",
    "diagnostics",
    "files",
    "privacy",
    "ai"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "assessmentId": { "$ref": "./common.schema.json#/$defs/uid" },
    "scenarioId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "scenarioDigest": { "$ref": "#/$defs/digest" },
    "planDigest": { "$ref": "#/$defs/digest" },
    "profile": { "enum": ["core", "at-fidelity"] },
    "target": { "type": "string", "format": "uri" },
    "goal": { "type": "string", "minLength": 1 },
    "standard": { "type": "string", "minLength": 1 },
    "status": { "enum": ["completed", "partial"] },
    "verdict": { "enum": ["pass", "fail", "unknown"] },
    "startedAt": { "$ref": "./common.schema.json#/$defs/isoTimestamp" },
    "finishedAt": { "$ref": "./common.schema.json#/$defs/isoTimestamp" },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "plannedLanes",
        "completedLanes",
        "missingArtifacts",
        "failedArtifacts"
      ],
      "properties": {
        "status": { "enum": ["complete", "incomplete"] },
        "plannedLanes": { "type": "integer", "minimum": 1 },
        "completedLanes": { "type": "integer", "minimum": 0 },
        "missingArtifacts": { "type": "integer", "minimum": 0 },
        "failedArtifacts": { "type": "integer", "minimum": 0 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions", "passed", "failed", "unknown", "findings", "artifacts"],
      "properties": {
        "actions": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 },
        "findings": { "type": "integer", "minimum": 0 },
        "artifacts": { "type": "integer", "minimum": 0 }
      }
    },
    "journeys": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "actions": { "type": "array", "items": { "type": "object" } },
    "findings": { "type": "array", "items": { "type": "object" } },
    "synthesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conclusion",
        "directJudgments",
        "releaseGates",
        "findingOccurrences",
        "incompleteRuleResults",
        "uniqueIncompleteRules",
        "lanes",
        "comparisons",
        "reader",
        "findings"
      ],
      "properties": {
        "conclusion": { "type": "string", "minLength": 1 },
        "directJudgments": { "$ref": "#/$defs/resultCounts" },
        "releaseGates": { "$ref": "#/$defs/resultCounts" },
        "findingOccurrences": { "type": "integer", "minimum": 0 },
        "incompleteRuleResults": { "type": "integer", "minimum": 0 },
        "uniqueIncompleteRules": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "lanes": { "type": "array", "items": { "type": "object" } },
        "comparisons": { "type": "array", "items": { "type": "object" } },
        "reader": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commands", "passed", "failed", "unknown"],
          "properties": {
            "commands": { "type": "integer", "minimum": 0 },
            "passed": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "unknown": { "type": "integer", "minimum": 0 }
          }
        },
        "findings": { "type": "array", "items": { "type": "object" } }
      }
    },
    "artifacts": { "type": "array", "items": { "type": "object" } },
    "diagnostics": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["html", "json", "markdown", "manifest", "plan"],
      "properties": {
        "html": { "type": "string", "minLength": 1 },
        "json": { "type": "string", "minLength": 1 },
        "markdown": { "type": "string", "minLength": 1 },
        "manifest": { "type": "string", "minLength": 1 },
        "plan": { "type": "string", "minLength": 1 }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "reviewedForSharing", "remoteUploadAuthorized"],
      "properties": {
        "classification": { "const": "sensitive" },
        "reviewedForSharing": { "const": false },
        "remoteUploadAuthorized": { "const": false }
      }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "label"],
      "properties": {
        "present": { "type": "boolean" },
        "label": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "resultCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed", "unknown"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
