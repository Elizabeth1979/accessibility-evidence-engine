{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Elizabeth1979/accessibility-evidence-engine/main/packages/schemas/json/keyboard-pointer-sweep-lane.schema.json",
  "title": "AEE Keyboard and Pointer Sweep Lane",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "laneId",
    "driver",
    "isolation",
    "status",
    "targetUrl",
    "allowedOrigins",
    "activateControls",
    "startedAt",
    "finishedAt",
    "blockedNavigations"
  ],
  "properties": {
    "schemaVersion": { "const": "0.2.0" },
    "laneId": { "$ref": "./common.schema.json#/$defs/uid" },
    "driver": { "const": "keyboard-pointer-sweep" },
    "isolation": { "enum": ["dedicated-browser-context", "test-page"] },
    "status": { "enum": ["completed", "blocked", "failed"] },
    "targetUrl": { "type": "string", "format": "uri" },
    "allowedOrigins": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uri" }
    },
    "activateControls": { "type": "boolean" },
    "pressedBy": { "enum": ["sweep", "test"] },
    "startedAt": { "$ref": "./common.schema.json#/$defs/isoTimestamp" },
    "finishedAt": { "$ref": "./common.schema.json#/$defs/isoTimestamp" },
    "blockedNavigations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "tabStops": { "type": "array", "items": { "$ref": "#/$defs/tabStop" } },
    "activated": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "failedNavigations": {
      "description": "Pages on the site a press set out for that did not load: Chrome showed its own error page, so the sweep read nothing there and compared the click with the key press by where each set out for.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["selector", "url", "reason"],
        "properties": {
          "selector": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "framesNotRead": {
      "description": "Frames whose content the sweep did not check, and why: one showing a page outside the allowed origins or Chrome's error page, one inside such a frame, or one no session could read. The frame element on the page is still swept.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "reason"],
        "properties": {
          "url": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
      "then": { "required": ["tabStops", "activated", "findings"] },
      "else": { "required": ["diagnostics"] }
    }
  ],
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "concept", "selector", "label", "summary"],
      "properties": {
        "kind": {
          "enum": [
            "pointer-only",
            "hover-only",
            "activation-differs",
            "focus-lost",
            "looks-like-heading",
            "status-not-announced",
            "failure-not-announced",
            "form-not-announced",
            "colour-only",
            "text-in-image"
          ]
        },
        "concept": {
          "enum": [
            "keyboard-operation",
            "hover-focus-equivalence",
            "focus-management",
            "heading-structure",
            "status-messages",
            "use-of-color",
            "images-of-text"
          ]
        },
        "selector": { "type": "string", "minLength": 1 },
        "framePath": {
          "description": "Inside a frame: the iframe elements it is inside, outermost first, each as a path in the document that holds it (as axe-core's target lists a node inside frames).",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "label": { "type": "string" },
        "text": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "targetBox": { "$ref": "#/$defs/targetBox" },
        "screenshot": { "type": "string", "pattern": "^press-[0-9]+\\.png$" }
      }
    },
    "tabStop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "label"],
      "properties": {
        "selector": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "role": { "type": "string" },
        "focusVisible": { "type": "boolean" },
        "notChecked": {
          "description": "Why its focus was not checked: it is a frame whose page the sweep does not read, so its pictures cover it. Names the site when its page is outside the allowed origins.",
          "type": "string",
          "minLength": 1
        },
        "focusCrop": { "type": "string", "pattern": "^tab-stop-[0-9]+\\.png$" },
        "targetBox": { "$ref": "#/$defs/targetBox" }
      }
    },
    "targetBox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height", "pageWidth", "pageHeight"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 },
        "pageWidth": { "type": "number", "minimum": 0 },
        "pageHeight": { "type": "number", "minimum": 0 }
      }
    }
  }
}
