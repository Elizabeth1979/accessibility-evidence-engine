{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Elizabeth1979/accessibility-evidence-engine/main/packages/schemas/json/interaction-comparison.schema.json",
  "title": "AEE Pointer and Keyboard Interaction Comparison",
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selector": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "exact": { "type": "boolean" }
      },
      "oneOf": [
        {
          "required": ["selector"],
          "not": { "anyOf": [{ "required": ["role"] }, { "required": ["name"] }] }
        },
        { "required": ["role", "name"], "not": { "required": ["selector"] } }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "kind": { "enum": ["hover", "click", "focus", "press"] },
        "target": { "$ref": "#/$defs/target" },
        "key": {
          "enum": [
            "Tab",
            "Shift+Tab",
            "Enter",
            "Space",
            "Escape",
            "ArrowUp",
            "ArrowDown",
            "ArrowLeft",
            "ArrowRight",
            "Home",
            "End"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "enum": ["hover", "click", "focus"] } },
            "required": ["kind"]
          },
          "then": { "required": ["target"], "not": { "required": ["key"] } }
        },
        {
          "if": { "properties": { "kind": { "const": "press" } }, "required": ["kind"] },
          "then": { "required": ["key"], "not": { "required": ["target"] } }
        }
      ]
    },
    "observe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/$defs/target" },
        "url": { "type": "boolean" },
        "visible": { "type": "boolean" },
        "text": { "type": "boolean" },
        "focused": { "type": "boolean" },
        "attributes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "anyOf": [
        { "properties": { "url": { "const": true } }, "required": ["url"] },
        { "properties": { "visible": { "const": true } }, "required": ["visible", "target"] },
        { "properties": { "text": { "const": true } }, "required": ["text", "target"] },
        { "properties": { "focused": { "const": true } }, "required": ["focused", "target"] },
        { "required": ["attributes", "target"] }
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "visible": { "type": "boolean" },
        "text": { "type": ["string", "null"] },
        "focused": { "type": "boolean" },
        "attributes": {
          "type": "object",
          "additionalProperties": { "type": ["string", "null"] }
        }
      },
      "minProperties": 1
    },
    "expectation": { "$ref": "#/$defs/observation" },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "pointerActions", "keyboardActions", "observe"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "pointerActions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/action" } },
        "keyboardActions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/action" }
        },
        "observe": { "$ref": "#/$defs/observe" },
        "expected": { "$ref": "#/$defs/expectation" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "action",
        "runId",
        "pageUrl",
        "results",
        "releaseVerdict",
        "reporterFiles",
        "artifactFiles"
      ],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "action": { "$ref": "#/$defs/action" },
        "runId": { "$ref": "./common.schema.json#/$defs/uid" },
        "pageUrl": { "type": "string", "format": "uri" },
        "results": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pass", "fail", "unknown"],
          "properties": {
            "pass": { "type": "integer", "minimum": 0 },
            "fail": { "type": "integer", "minimum": 0 },
            "unknown": { "type": "integer", "minimum": 0 }
          }
        },
        "releaseVerdict": { "enum": ["pass", "fail", "unknown"] },
        "reporterFiles": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "artifactFiles": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["driver", "steps", "observation", "video"],
      "properties": {
        "driver": { "enum": ["pointer", "keyboard"] },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
        "observation": { "$ref": "#/$defs/observation" },
        "video": { "$ref": "#/$defs/videoEvidence" }
      }
    },
    "videoEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["videoFile", "sidecarFile", "captionsFile"],
      "properties": {
        "videoFile": { "type": "string", "minLength": 1 },
        "sidecarFile": { "type": "string", "minLength": 1 },
        "captionsFile": { "type": "string", "minLength": 1 }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "comparisonId",
    "name",
    "isolation",
    "status",
    "targetUrl",
    "allowedOrigins",
    "startedAt",
    "finishedAt",
    "traceFile"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "comparisonId": { "$ref": "./common.schema.json#/$defs/uid" },
    "name": { "type": "string", "minLength": 1 },
    "isolation": { "const": "separate-dedicated-browser-contexts" },
    "status": { "enum": ["completed", "blocked", "failed"] },
    "targetUrl": { "type": "string", "format": "uri" },
    "allowedOrigins": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uri" }
    },
    "startedAt": { "$ref": "./common.schema.json#/$defs/isoTimestamp" },
    "finishedAt": { "$ref": "./common.schema.json#/$defs/isoTimestamp" },
    "initialState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "resolvedUrl", "contentHash"],
      "properties": {
        "strategy": { "const": "shared-playwright-storage-state" },
        "resolvedUrl": { "type": "string", "format": "uri" },
        "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "lanes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointer", "keyboard"],
      "properties": {
        "pointer": { "$ref": "#/$defs/lane" },
        "keyboard": { "$ref": "#/$defs/lane" }
      }
    },
    "equivalence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "summary"],
      "properties": {
        "verdict": { "enum": ["pass", "fail"] },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "expected", "summary"],
      "properties": {
        "verdict": { "enum": ["pass", "fail"] },
        "expected": { "$ref": "#/$defs/expectation" },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "traceFile": { "type": "string", "minLength": 1 },
    "manifestFile": { "type": "string", "minLength": 1 },
    "diagnostics": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "completed" } } },
      "then": { "required": ["initialState", "lanes", "equivalence", "manifestFile"] }
    },
    {
      "if": { "properties": { "status": { "enum": ["blocked", "failed"] } } },
      "then": { "required": ["diagnostics"] }
    }
  ]
}
