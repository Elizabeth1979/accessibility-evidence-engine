{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aee.dev/schemas/scenario-plan.schema.json",
  "title": "AEE compiled scenario plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scenarioId",
    "scenarioDigest",
    "planDigest",
    "target",
    "standard",
    "profile",
    "goal",
    "approval",
    "readiness",
    "requiredCapabilities",
    "journeys",
    "safety",
    "privacy"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "scenarioId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "scenarioDigest": { "$ref": "#/$defs/digest" },
    "planDigest": { "$ref": "#/$defs/digest" },
    "target": { "type": "string", "format": "uri" },
    "standard": { "type": "string", "minLength": 1 },
    "profile": { "enum": ["core", "at-fidelity"] },
    "goal": { "type": "string", "minLength": 1 },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status"],
      "properties": {
        "required": { "const": true },
        "status": { "enum": ["pending", "approved", "digest-mismatch"] }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "blockingCapabilityIds"],
      "properties": {
        "status": { "enum": ["ready", "blocked"] },
        "summary": { "type": "string", "minLength": 1 },
        "blockingCapabilityIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        }
      }
    },
    "requiredCapabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capability" }
    },
    "journeys": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/plannedJourney" }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedOrigins", "allowedActions", "forbiddenActions", "conflicts"],
      "properties": {
        "allowedOrigins": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri" }
        },
        "allowedActions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "forbiddenActions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "conflicts": {
          "type": "array",
          "maxItems": 0,
          "items": { "type": "string" }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage", "remoteUpload", "sharingReviewRequired"],
      "properties": {
        "storage": { "enum": ["local", "custom"] },
        "remoteUpload": { "enum": ["forbidden", "explicit-only"] },
        "sharingReviewRequired": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "requirement", "implementationStatus"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["active-lane", "passive-observer", "reporter"] },
        "requirement": { "enum": ["required", "optional"] },
        "implementationStatus": { "enum": ["available", "partial", "planned"] }
      }
    },
    "plannedJourney": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "goal", "startUrl", "steps"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "startUrl": { "type": "string", "format": "uri" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "source"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "label": { "type": "string", "minLength": 1 },
              "source": { "enum": ["profile", "user-permission", "user-command"] }
            }
          }
        }
      }
    }
  }
}
