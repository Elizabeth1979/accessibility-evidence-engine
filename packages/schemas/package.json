{
  "name": "@aee/schemas",
  "version": "0.8.0",
  "description": "JSON Schemas and runtime validation for Accessibility Evidence Engine artifacts.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./json/*": "./json/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "!dist/**/*.test.*",
    "json"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elizabeth1979/accessibility-evidence-engine.git",
    "directory": "packages/schemas"
  },
  "homepage": "https://github.com/Elizabeth1979/accessibility-evidence-engine#readme",
  "bugs": {
    "url": "https://github.com/Elizabeth1979/accessibility-evidence-engine/issues"
  },
  "keywords": [
    "accessibility",
    "evidence",
    "json-schema",
    "validation",
    "testing"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
