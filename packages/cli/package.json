{
  "name": "@aee/cli",
  "version": "0.1.0",
  "description": "Approved-scenario command-line runner for Accessibility Evidence Engine.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "aee": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "dist/scenario.js",
    "dist/scenario.js.map",
    "dist/scenario.d.ts",
    "dist/scenario-runner.js",
    "dist/scenario-runner.js.map",
    "dist/scenario-runner.d.ts"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elizabeth1979/accessibility-evidence-engine.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Elizabeth1979/accessibility-evidence-engine#readme",
  "bugs": {
    "url": "https://github.com/Elizabeth1979/accessibility-evidence-engine/issues"
  },
  "keywords": [
    "accessibility",
    "evidence",
    "playwright",
    "testing",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@aee/core": "0.1.0",
    "@aee/judges": "0.1.0",
    "@aee/observers": "0.1.0",
    "@aee/playwright": "0.1.0",
    "@aee/reporter": "0.1.0",
    "@aee/schemas": "0.1.0",
    "yaml": "^2.9.1",
    "playwright": "^1.62.1"
  }
}
