{
  "name": "@aee/cli",
  "version": "0.4.1",
  "description": "Approved-scenario command-line runner and verified fixes for Accessibility Evidence Engine.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./test": {
      "types": "./dist/test-fixture.d.ts",
      "require": "./dist/test-fixture.js",
      "default": "./dist/test-fixture.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "aee": "dist/index.js"
  },
  "files": [
    "dist/fix.js",
    "dist/fix.js.map",
    "dist/fix.d.ts",
    "dist/fix-command.js",
    "dist/fix-command.js.map",
    "dist/fix-command.d.ts",
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "dist/pr-comment.js",
    "dist/pr-comment.js.map",
    "dist/pr-comment.d.ts",
    "dist/scenario.js",
    "dist/scenario.js.map",
    "dist/scenario.d.ts",
    "dist/scenario-runner.js",
    "dist/scenario-runner.js.map",
    "dist/scenario-runner.d.ts",
    "dist/test-fixture.js",
    "dist/test-fixture.js.map",
    "dist/test-fixture.d.ts",
    "assets/aee-display.woff2",
    "assets/Fraunces-OFL.txt"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elizabeth1979/accessibility-evidence-engine.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Elizabeth1979/accessibility-evidence-engine#readme",
  "bugs": {
    "url": "https://github.com/Elizabeth1979/accessibility-evidence-engine/issues"
  },
  "keywords": [
    "accessibility",
    "evidence",
    "playwright",
    "testing",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@aee/ai-fixes": "0.4.1",
    "@aee/core": "0.4.1",
    "@aee/judges": "0.4.1",
    "@aee/observers": "0.4.1",
    "@aee/playwright": "0.4.1",
    "@aee/reporter": "0.4.1",
    "@aee/schemas": "0.4.1",
    "@babel/parser": "^7.29.9",
    "parse5": "^7.3.0",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@playwright/test": "^1.50.0"
  }
}
