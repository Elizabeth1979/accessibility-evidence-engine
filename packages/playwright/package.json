{
  "name": "@aee/playwright",
  "version": "0.1.0",
  "description": "Playwright adapter for evidence-first accessibility investigations with Accessibility Evidence Engine.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "dist/evidence-manifest.js",
    "dist/evidence-manifest.js.map",
    "dist/evidence-manifest.d.ts",
    "dist/virtual-screen-reader.js",
    "dist/virtual-screen-reader.js.map",
    "dist/virtual-screen-reader.d.ts"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elizabeth1979/accessibility-evidence-engine.git",
    "directory": "packages/playwright"
  },
  "homepage": "https://github.com/Elizabeth1979/accessibility-evidence-engine#readme",
  "bugs": {
    "url": "https://github.com/Elizabeth1979/accessibility-evidence-engine/issues"
  },
  "keywords": [
    "accessibility",
    "evidence",
    "playwright",
    "testing",
    "automation"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@axe-core/playwright": "4.13.0",
    "@aee/core": "0.1.0",
    "@aee/judges": "0.1.0",
    "@aee/observers": "0.1.0",
    "@aee/reporter": "0.1.0",
    "@aee/schemas": "0.1.0"
  }
}
