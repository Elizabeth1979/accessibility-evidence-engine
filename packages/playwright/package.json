{
  "name": "@aee/playwright",
  "version": "0.8.0",
  "description": "Playwright adapter for evidence-first accessibility investigations with Accessibility Evidence Engine.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.LICENSE",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elizabeth1979/accessibility-evidence-engine.git",
    "directory": "packages/playwright"
  },
  "homepage": "https://github.com/Elizabeth1979/accessibility-evidence-engine#readme",
  "bugs": {
    "url": "https://github.com/Elizabeth1979/accessibility-evidence-engine/issues"
  },
  "keywords": [
    "accessibility",
    "evidence",
    "playwright",
    "testing",
    "automation"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@aee/core": "0.8.0",
    "@aee/judges": "0.8.0",
    "@aee/observers": "0.8.0",
    "@aee/reporter": "0.8.0",
    "@aee/schemas": "0.8.0",
    "@axe-core/playwright": "4.14.0",
    "@guidepup/virtual-screen-reader": "0.32.1",
    "aria-query": "5.3.2",
    "axe-core": "4.14.0",
    "pngjs": "7.0.0",
    "tabbable": "6.5.0"
  }
}
