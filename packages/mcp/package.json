{
  "name": "@aee/mcp",
  "version": "0.6.0",
  "description": "MCP server that lets a coding agent run Accessibility Evidence Engine and explain a finding with its a11y-skills pattern.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "aee-mcp": "dist/bin.js"
  },
  "files": [
    "dist/bin.js",
    "dist/bin.js.map",
    "dist/bin.d.ts",
    "dist/explain.js",
    "dist/explain.js.map",
    "dist/explain.d.ts",
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elizabeth1979/accessibility-evidence-engine.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/Elizabeth1979/accessibility-evidence-engine#readme",
  "bugs": {
    "url": "https://github.com/Elizabeth1979/accessibility-evidence-engine/issues"
  },
  "keywords": [
    "accessibility",
    "mcp",
    "a11y-skills",
    "coding-agent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@aee/cli": "0.6.0",
    "@aee/playwright": "0.6.0",
    "@aee/schemas": "0.6.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "a11y-skills": "github:Elizabeth1979/a11y-skills#e0dfbeb50b453f9fd87423a1c7d4d29c9ccc4c15",
    "zod": "^4.6.5"
  }
}
